{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "icon": {
      "type": "enumeration",
      "enum": [
        "no-smoking",
        "  heart",
        "  lightning",
        "  check",
        "  shield",
        "  star"
      ]
    },
    "color": {
      "type": "enumeration",
      "enum": [
        " blue",
        "  emerald",
        "  purple",
        "  orange",
        "  red"
      ]
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "duration": {
      "type": "string"
    }
  }
}

{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "text",
      "required": true
    },
    "service": {
      "type": "string"
    },
    "rating": {
      "type": "integer",
      "required": true,
      "default": 5
    },
    "published": {
      "type": "boolean",
      "default": false
    }
  }
}
